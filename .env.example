# NextAuth Configuration
# Genera un secret seguro con: `openssl rand -base64 32`
NEXTAUTH_SECRET=your_nextauth_secret_here_random_string_32_chars
NEXTAUTH_URL=http://localhost:3000

# Google OAuth 2.0 Credentials
# Obtén estas credenciales desde Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# Asegúrate de habilitar "Google Drive API" en tu proyecto de Google Cloud.
# Authorized JavaScript origins: http://localhost:3000 y tu URL de producción en Vercel
# Authorized redirect URIs: http://localhost:3000/api/auth/callback/google y https://<tu-app>.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Configuración Opcional para Carpeta por Defecto de Google Drive (ID de carpeta)
# Si se deja vacío, buscará en todo el Google Drive del usuario.
NEXT_PUBLIC_DEFAULT_DRIVE_FOLDER_ID=
